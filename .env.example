# Copie para .env (gitignored) e preencha só o que o patch em que você está exige.
# Todo o caminho offline (patches 1-12) roda sem nenhuma chave.

# Gemini Deep Research — necessária só no patch 14 (US$ 1-3 por run).
GEMINI_API_KEY=

# DeepSeek (extract/normalize) — necessária só no patch 13 (~US$ 0,01 por run).
DEEPSEEK_API_KEY=

# Estruturador: fixture = lê tests/fixtures/llm_responses/ (offline, custo zero)
#               deepseek = chamada real (patch 13)
RP_LLM=fixture

# Camada de pesquisa: none = exige --report PATH com relatório salvo
#                     gemini = dispara Deep Research de verdade (patch 14)
RP_RESEARCH=none
